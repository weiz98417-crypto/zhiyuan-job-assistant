# 筝筝纸鸢 — Environment Variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env

# ── Turso (Cloud SQLite) ────────────────────────────────────────────────────
# Required for: 生产环境数据库持久化（Railway 部署必备）
# Free at: https://turso.tech — 500MB storage, 1B row reads/month
# TURSO_URL=libsql://your-db.turso.io
# TURSO_TOKEN=your_auth_token

# ── DeepSeek Integration ────────────────────────────────────────────────────
# Required for: AI evaluation, CV analysis, interview question generation
# Free API key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── Zhipu (智谱) Integration ──────────────────────────────────────────────────
# Required for: OCR 识别 JD 截图（岗位描述图片转文字）
# Free API key: https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=your_zhipu_api_key_here
# Optional: 智谱视觉模型。默认使用官方 API id: glm-5v-turbo
# ZHIPU_VISION_MODEL=glm-5v-turbo
# Optional: 智谱作为 LLM 兜底时使用的模型。默认沿用 ZHIPU_VISION_MODEL。
# ZHIPU_FALLBACK_MODEL=glm-5v-turbo

# ── MinerU Local Document Extraction ───────────────────────────────────────
# Used for scanned/empty PDF resume extraction after lightweight local PDF text
# extraction fails. It replaces qwen-long file extraction for PDF/DOCX fallback.
# MINERU_EXECUTABLE=C:\Users\Admin\Documents\求职\zhiyuan-job-assistant-master\MinerU-master\.venv\Scripts\mineru.exe
# MINERU_MODEL_SOURCE=local
# MINERU_TOOLS_CONFIG_JSON=C:\Users\Admin\mineru.json
# MINERU_EXTRACTION_TIMEOUT_MS=180000

# ── Auth: JWT Secret ──────────────────────────────────────────────────────
# Required for: 多用户登录系统。生产环境必须设置 ≥32 字符随机字符串。
# 开发环境可使用默认值，但启动时会警告。
# 生成随机字符串: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET=your_random_32_char_secret_here

# ── Optional: Override default DeepSeek model ───────────────────────────────
# Default: deepseek-chat
# DEEPSEEK_MODEL=deepseek-chat

# ── MCP Server Integration ──────────────────────────────────────────────────
# SerpAPI MCP — web search (Google/Bing/Baidu)
# Free tier: 100 searches/month at https://serpapi.com
SERPAPI_API_KEY=your_serpapi_key_here

# Baidu Map MCP — weather, location search, route planning (optional)
# Free tier: https://lbsyun.baidu.com/apiconsole/key
# BAIDU_MAP_API_KEY=your_baidu_map_key_here

# PostgreSQL foundation (optional until cutover)
# DATABASE_URL=postgresql://your_user:your_password@localhost:5432/zhiyuan
# DB_DRIVER=sqlite
# POSTGRES_MAX_CONNECTIONS=5
# POSTGRES_SCHEMA_PATH=src/lib/postgres-schema.sql

# Long-term memory embeddings (optional until PostgreSQL + pgvector cutover)
# Provider values: disabled | mock | openai-compatible
# For Alibaba Cloud Bailian, use the OpenAI-compatible embeddings endpoint.
# MEMORY_EMBEDDING_PROVIDER=openai-compatible
# MEMORY_EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
# MEMORY_EMBEDDING_MODEL=text-embedding-v4
# MEMORY_EMBEDDING_DIMENSION=1536
# MEMORY_EMBEDDING_API_KEY=your_embedding_api_key_here
# If omitted, the app falls back to DASHSCOPE_API_KEY.
# MEMORY_EMBEDDING_MAX_RETRIES=2
