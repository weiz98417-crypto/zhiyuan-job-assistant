{
  "name": "zhiyuan-job-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered job search assistant for the Chinese market",
  "scripts": {
    "dev": "next dev",
    "prestart": "node scripts/turso-pull.mjs",
    "turso-push": "node scripts/turso-push.mjs",
    "build": "next build",
    "build:worker": "node scripts/build-agent-worker.mjs",
    "build:production": "npm run build && npm run build:worker",
    "build:railway": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=1 next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "doctor": "node doctor.mjs",
    "verify": "node verify-pipeline.mjs",
    "normalize": "node normalize-statuses.mjs",
    "dedup": "node dedup-tracker.mjs",
    "merge": "node merge-tracker.mjs",
    "pdf": "node generate-pdf.mjs",
    "sync-check": "node cv-sync-check.mjs",
    "liveness": "node check-liveness.mjs",
    "install:playwright": "node scripts/install-playwright.mjs",
    "check:postgres": "node scripts/check-postgres.mjs",
    "check:postgres-cutover": "node scripts/check-postgres-cutover.mjs",
    "check:agent-runtime": "node scripts/check-agent-runtime-preflight.mjs",
    "check:jd-eval-partials": "node scripts/check-jd-eval-partials.mjs",
    "backup:postgres": "node scripts/backup-postgres.mjs",
    "restore:postgres": "node scripts/restore-postgres.mjs",
    "migrate:postgres": "node scripts/migrate-sqlite-to-postgres.mjs",
    "check:postgres-migration": "node scripts/check-postgres-migration.mjs",
    "backfill:memory": "node scripts/backfill-memory.mjs",
    "retry:memory": "node scripts/backfill-memory.mjs --retry-failed",
    "eval:memory": "vitest run src/__tests__/memory-eval-harness.test.ts",
    "eval:agent-runtime": "vitest run src/__tests__/agent-runtime-regressions.eval.test.ts",
    "e2e:agent-tasks": "vitest run src/__tests__/agent-task-runtime.e2e.test.ts src/__tests__/server-agent-loop-gate.test.ts src/__tests__/durable-orchestrator-engine.test.ts",
    "e2e:agent-feature-shapes": "vitest run src/__tests__/agent-task-runtime.e2e.test.ts src/__tests__/agent-feature-shapes.e2e.test.ts src/__tests__/agent-task-journey.test.ts",
    "e2e:agent-journeys": "vitest run src/__tests__/agent-task-journey.test.ts src/__tests__/agent-journey-eval.test.ts src/__tests__/agent-task-runtime.e2e.test.ts",
    "e2e:agent": "node scripts/run-agent-e2e-suite.mjs",
    "eval:agent-deterministic": "vitest run src/__tests__/agent-surface-projection.test.ts src/__tests__/agent-item-projection.test.ts src/__tests__/agent-task-journey.test.ts src/__tests__/agent-journey-eval.test.ts src/__tests__/agent-task-runtime.e2e.test.ts",
    "eval:agent-pr": "npm run eval:agent-deterministic && vitest run src/__tests__/agent-eval-runs.test.ts src/__tests__/agent-staging-judge.test.ts",
    "eval:agent-staging": "node scripts/run-agent-eval.mjs --mode=staging",
    "eval:agent-release": "node scripts/run-agent-eval.mjs --mode=release",
    "e2e:agent-runtime-postgres-faults": "node scripts/e2e-agent-runtime-postgres-faults.mjs",
    "smoke:embedding": "node scripts/smoke-embedding.mjs",
    "cleanup:profile-signals": "node scripts/cleanup-profile-signals.mjs",
    "scan": "node scan.mjs",
    "scan:worker": "node scripts/scan-worker.mjs",
    "scan:once": "node scripts/scan-worker.mjs --once",
    "scan-risks": "node scripts/scan-risks.mjs",
    "check-onboarding": "node scripts/check-onboarding.mjs",
    "security:promote-superadmin": "node scripts/promote-sole-admin.mjs",
    "security:preflight": "node scripts/check-auth-security-preflight.mjs",
    "security:retry-alerts": "node scripts/retry-security-alerts.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@libsql/client": "^0.17.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/canvas": "^1.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "antd": "^6.6.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "cheerio": "^1.2.0",
    "dexie": "^4.4.2",
    "dommatrix": "^0.1.1",
    "dotenv": "^16.4.5",
    "framer-motion": "^12.38.0",
    "jose": "^6.2.3",
    "js-yaml": "^4.1.1",
    "lucide-react": "^1.14.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.4",
    "next": "16.2.4",
    "pdf-parse": "^2.4.5",
    "pdf2json": "^4.0.3",
    "pg": "^8.21.0",
    "playwright": "^1.59.1",
    "puppeteer": "^24.43.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "redis": "^5.8.2",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.4",
    "thinking-orbs": "^0.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "esbuild": "^0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7.2.7",
    "vitest": "^4.1.6"
  }
}
